# 外部数据依赖 —— 本仓不内嵌任何机器路径, 使用前请复制为 .env 并按实际填写
#   cp .env.example .env && set -a && . ./.env && set +a

# 数据集本地副本(build_dataset 的产物; 训练与回测都从这里读)
IDXML_DS_ROOT=./data

# 中间产物缓存(面板/标签/预测)。不设则默认落在 <repo>/cache
# IDXML_CACHE=./cache

# ── 原始数据源 ────────────────────────────────────────────────
# 247 个 Level-2 微观结构因子, 5 分钟长表: [datetime, symbol, <factor>]
IDXML_FACTOR_ROOT=

# 1 分钟网格的前向收益(用于构造标签)
IDXML_FWDRET_ROOT=

# 涨跌停 / 停牌状态, 需包含 14:55 时点(决策时点的可交易性判定)
IDXML_LIMIT_ROOT=

# 指数每日成分与权重
IDXML_WEIGHT_ROOT=

# ── 风格因子所需(可选, 仅 barra_styles / styleutil 用到) ────────
IDXML_PRICE_DAILY=
IDXML_VALUATION=
IDXML_FININD=
IDXML_BALANCE=
IDXML_INDUSTRY=
